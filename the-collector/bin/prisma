#!/Users/szili/anaconda3/bin/python3
# -*- coding: utf-8 -*-
"""
PRISMA napló és folyamatábra a Collector-höz — az azonosítástól a beválogatásig.

A `collect` szándékosan túl-gyűjt és a szűrést emberi ítéletre hagyja; ez a modul
azt teszi *auditálhatóvá és reprodukálhatóvá*, amit a bírálók számonkérnek:
a keresési stratégiát (adatbázis, dátum, keresőkifejezés, találatszám) és a
PRISMA 2020 folyamatot (azonosított → duplikátum eltávolítva → szűrt → kizárt →
teljes szöveg → beválogatott). Nincs benne LLM-hívás: a döntéseket te hozod, ez
csak rögzíti és determinisztikusan összeszámolja őket.

Állapot: <outdir>/prisma/<project>.json

Tipikus munkafolyamat
---------------------
    collect --query '...' --outdir ~/Documents/PubMed_Downloads      # keres + naplóz
    prisma ingest   --project endo-diet                              # napló + CSV beolvasása
    prisma dedup    --project endo-diet --auto                       # duplikátumok
    prisma template --project endo-diet                              # szűrési döntés-CSV kiírása
    #  ... a CSV decision/reason/phase oszlopainak kitöltése ...
    prisma screen   --project endo-diet --from-csv dontesek.csv      # döntések visszaolvasása
    prisma status   --project endo-diet                              # a folyamat számai
    prisma export   --project endo-diet --format all                 # Methods-blokk, PRISMA-S, ábra, RIS/CSV

Import (előtte) és export (utána)
---------------------------------
    prisma import <masik-projekt.json | dontesek.csv> --project endo-diet
    prisma export --project endo-diet --format flowchart

Függőség: nincs. Csak a Python standard könyvtár.
"""

from __future__ import annotations

import argparse
import csv
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

SCHEMA = "the-collector.prisma/v1"
DEFAULT_OUTDIR = Path.home() / "Documents" / "PubMed_Downloads"

# A collect CSV letöltési státusza -> van-e teljes szöveg a kézben.
_RETRIEVED = {"Letöltve (PDF)", "Letöltve (XML)"}


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def year_of(pubdate: str) -> str:
    """Az első négyjegyű évszám a publikációs dátumból."""
    m = re.search(r"\b(\d{4})\b", pubdate or "")
    return m.group(1) if m else ""


# --------------------------------------------------------------------------
# Állapot betöltése / mentése
# --------------------------------------------------------------------------


def state_path(outdir: Path, project: str) -> Path:
    return outdir.expanduser() / "prisma" / f"{project}.json"


def fresh_state(project: str, title: str = "") -> dict:
    ts = now_iso()
    return {
        "schema": SCHEMA,
        "project": project,
        "title": title,
        "prisma_version": "2020",
        "created": ts,
        "updated": ts,
        # Azonosítás: adatbázis-keresések és regiszterek. kind: database|register|other
        "searches": [],
        # Szűrés előtt eltávolítva
        "dedup_removed": 0,
        "removed_before_screening": [],  # [{"reason": str, "count": int}]
        # Rekordonkénti, auditálható szűrési napló, pmid szerint kulcsolva
        "records": {},
    }


def load_state(outdir: Path, project: str, create: bool = False) -> dict:
    path = state_path(outdir, project)
    if path.exists():
        state = json.loads(path.read_text(encoding="utf-8"))
        state.setdefault("removed_before_screening", [])
        state.setdefault("searches", [])
        state.setdefault("records", {})
        return state
    if create:
        return fresh_state(project)
    sys.exit(
        f"Nincs PRISMA állapot: {path}\n"
        f"  Előbb:  prisma init --project {project}   vagy   prisma ingest --project {project}"
    )


def save_state(state: dict, outdir: Path, project: str) -> Path:
    state["updated"] = now_iso()
    path = state_path(outdir, project)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    return path


def new_record(pmid: str) -> dict:
    return {
        "pmid": pmid,
        "cim": "",
        "folyoirat": "",
        "doi": "",
        "publikacio_datuma": "",
        "pubmed_url": "",
        "source": "",
        "topic": "",
        "fulltext": "",       # retrieved | not_retrieved | ""
        "decision": "",       # include | exclude | ""
        "reason": "",
        "phase": "",          # screen | eligibility | ""
    }


# --------------------------------------------------------------------------
# Beolvasás: keresési napló + collect CSV
# --------------------------------------------------------------------------


def read_search_log(path: Path) -> list[dict]:
    if not path.exists():
        return []
    entries: list[dict] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            print(f"  ! rossz sor a naplóban, kihagyva: {line[:60]}", file=sys.stderr)
    return entries


def read_collect_csv(path: Path) -> list[dict]:
    if not path.exists():
        return []
    with path.open("r", encoding="utf-8-sig", newline="") as fh:
        return list(csv.DictReader(fh))


def ingest(state: dict, outdir: Path, csv_path: Path | None, log_path: Path | None,
           source: str) -> None:
    """A keresési naplóból az azonosítási számok, a CSV-ből a rekordok."""
    log_path = log_path or (outdir / "kereses_naplo.jsonl")
    csv_path = csv_path or (outdir / "osszesitett_lista.csv")

    # --- Keresések (azonosítás) ---
    existing = {(s.get("database"), s.get("query"), s.get("timestamp")) for s in state["searches"]}
    added_searches = 0
    for e in read_search_log(log_path):
        key = (e.get("database"), e.get("query"), e.get("timestamp"))
        if key in existing:
            continue
        state["searches"].append({
            "kind": "database",
            "source": e.get("database", "PubMed"),
            "topic": e.get("topic", ""),
            "query": e.get("query", ""),
            "date": (e.get("timestamp", "")[:10]),
            "count_total": int(e.get("count_total", 0) or 0),
            "retrieved": int(e.get("retrieved", 0) or 0),
            "filters": e.get("filters", ""),
        })
        existing.add(key)
        added_searches += 1

    # --- Rekordok (a ténylegesen behozott, szűrhető halmaz) ---
    added_rec = updated_rec = 0
    for row in read_collect_csv(csv_path):
        pmid = str(row.get("pmid", "")).strip()
        if not pmid:
            continue
        rec = state["records"].get(pmid)
        if rec is None:
            rec = new_record(pmid)
            state["records"][pmid] = rec
            added_rec += 1
        else:
            updated_rec += 1
        rec["cim"] = row.get("cim", rec["cim"])
        rec["folyoirat"] = row.get("folyoirat", rec["folyoirat"])
        rec["doi"] = row.get("doi", rec["doi"])
        rec["publikacio_datuma"] = row.get("publikacio_datuma", rec["publikacio_datuma"])
        rec["pubmed_url"] = row.get("pubmed_url", rec["pubmed_url"])
        rec["source"] = source
        rec["topic"] = row.get("tema", rec["topic"])
        # Teljes szöveg állapota a letöltési státuszból (csak ha még nincs beállítva).
        if not rec["fulltext"]:
            rec["fulltext"] = "retrieved" if row.get("statusz", "") in _RETRIEVED else "not_retrieved"

    print(f"Beolvasva: {added_searches} új keresés, {added_rec} új rekord, "
          f"{updated_rec} frissítve.")
    if not state["searches"]:
        print("  ! Nincs keresési napló. Fusson előbb a collect, vagy add hozzá kézzel: "
              "prisma add-source ...", file=sys.stderr)


# --------------------------------------------------------------------------
# Duplikátumok, szűrési döntések
# --------------------------------------------------------------------------


def _norm_title(t: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", (t or "").lower()).strip()


def dedup(state: dict, auto: bool, removed_manual: int | None) -> None:
    if removed_manual is not None:
        state["dedup_removed"] = int(removed_manual)
        print(f"Duplikátum szám kézzel beállítva: {state['dedup_removed']}")
        return
    if not auto:
        print("Adj meg --auto (DOI/cím szerinti) vagy --removed N (külső dedup) opciót.")
        return

    seen_doi: dict[str, str] = {}
    seen_title: dict[str, str] = {}
    removed = 0
    for pmid in list(state["records"]):
        rec = state["records"][pmid]
        doi = (rec.get("doi") or "").strip().lower()
        title = _norm_title(rec.get("cim", ""))
        dup_of = None
        if doi and doi in seen_doi:
            dup_of = seen_doi[doi]
        elif title and title in seen_title:
            dup_of = seen_title[title]
        if dup_of:
            del state["records"][pmid]  # az egyedi halmazból kikerül
            removed += 1
            continue
        if doi:
            seen_doi[doi] = pmid
        if title:
            seen_title[title] = pmid
    state["dedup_removed"] = state.get("dedup_removed", 0) + removed
    print(f"Automatikus dedup: {removed} duplikátum eltávolítva "
          f"(összesen rögzített: {state['dedup_removed']}).")


def apply_decisions(state: dict, rows: list[dict]) -> tuple[int, int]:
    """Döntés-sorok alkalmazása. Oszlopok: pmid, decision, reason, phase."""
    applied = skipped = 0
    for row in rows:
        pmid = str(row.get("pmid", "")).strip()
        if not pmid:
            continue
        decision = (row.get("decision", "") or "").strip().lower()
        if decision not in ("", "include", "exclude"):
            print(f"  ! ismeretlen döntés '{decision}' ({pmid}), kihagyva.", file=sys.stderr)
            skipped += 1
            continue
        if decision == "":
            continue  # kitöltetlen sor
        rec = state["records"].get(pmid)
        if rec is None:
            rec = new_record(pmid)
            rec["cim"] = row.get("cim", "")
            state["records"][pmid] = rec
        phase = (row.get("phase", "") or "").strip().lower()
        if decision == "exclude" and phase not in ("screen", "eligibility"):
            phase = "screen"  # alapértelmezés: cím/absztrakt szintű kizárás
        if decision == "include":
            phase = "eligibility"
        rec["decision"] = decision
        rec["reason"] = (row.get("reason", "") or "").strip()
        rec["phase"] = phase
        applied += 1
    return applied, skipped


# --------------------------------------------------------------------------
# PRISMA 2020 folyamat kiszámítása
# --------------------------------------------------------------------------


def compute_flow(state: dict) -> dict:
    searches = state.get("searches", [])
    db = [s for s in searches if s.get("kind", "database") == "database"]
    reg = [s for s in searches if s.get("kind") == "register"]
    other = [s for s in searches if s.get("kind") == "other"]

    id_db = sum(int(s.get("count_total", 0)) for s in db)
    id_reg = sum(int(s.get("count_total", 0)) for s in reg)
    id_other = sum(int(s.get("count_total", 0)) for s in other)
    retrieved_total = sum(int(s.get("retrieved", 0)) for s in searches)

    recs = list(state.get("records", {}).values())
    screened = len(recs)  # az egyedi, behozott halmaz, amit ténylegesen szűrünk

    excl_screen = sum(1 for r in recs if r["decision"] == "exclude" and r["phase"] == "screen")
    sought = screened - excl_screen

    # "Reports not retrieved": a szűrésen átjutott, de teljes szöveg nélküli, még el
    # nem bírált rekordok (ha kizártad/beválogattad, akkor kézben volt a szöveg).
    def is_sought(r: dict) -> bool:
        return not (r["decision"] == "exclude" and r["phase"] == "screen")

    not_retrieved = sum(
        1 for r in recs
        if is_sought(r) and r["fulltext"] == "not_retrieved" and r["decision"] == ""
    )
    assessed = sought - not_retrieved

    excl_elig_rows = [r for r in recs if r["decision"] == "exclude" and r["phase"] == "eligibility"]
    excl_elig = len(excl_elig_rows)
    reasons: dict[str, int] = {}
    for r in excl_elig_rows:
        reasons[r["reason"] or "ok nélkül"] = reasons.get(r["reason"] or "ok nélkül", 0) + 1

    included = sum(1 for r in recs if r["decision"] == "include")
    undecided = assessed - excl_elig - included  # elbírálásra vár

    dedup_removed = int(state.get("dedup_removed", 0))
    removed_other = state.get("removed_before_screening", [])
    removed_other_n = sum(int(x.get("count", 0)) for x in removed_other)

    identified_total = id_db + id_reg + id_other
    return {
        "databases": db, "registers": reg, "other_sources": other,
        "identified_databases": id_db,
        "identified_registers": id_reg,
        "identified_other": id_other,
        "identified_total": identified_total,
        "retrieved_total": retrieved_total,
        "retrieval_gap": max(0, identified_total - retrieved_total),
        "dedup_removed": dedup_removed,
        "removed_before_screening": removed_other,
        "removed_before_screening_n": removed_other_n,
        "screened": screened,
        "excluded_screening": excl_screen,
        "sought_for_retrieval": sought,
        "not_retrieved": not_retrieved,
        "assessed_eligibility": assessed,
        "excluded_eligibility": excl_elig,
        "excluded_eligibility_reasons": reasons,
        "included": included,
        "undecided": undecided,
    }


def status_text(state: dict) -> str:
    f = compute_flow(state)
    lines: list[str] = []
    lines.append(f"PRISMA 2020 — projekt: {state['project']}  (frissítve: {state['updated']})")
    lines.append("=" * 64)
    lines.append("AZONOSÍTÁS (keresési naplóból)")
    for s in f["databases"] + f["registers"] + f["other_sources"]:
        lines.append(f"  {s.get('source',''):<12} {s.get('date',''):<11} "
                     f"Count={s.get('count_total',0):<7} behozva={s.get('retrieved',0)}")
    lines.append(f"  Azonosított összesen: {f['identified_total']}  "
                 f"(adatbázis {f['identified_databases']}, regiszter {f['identified_registers']}, "
                 f"egyéb {f['identified_other']})")
    if f["retrieval_gap"] > 0:
        lines.append(f"  ! FIGYELEM: {f['retrieval_gap']} azonosított rekord NEM került be a "
                     f"korpuszba (retmax-korlát). A lenti szűrés a behozott {f['retrieved_total']} "
                     f"rekordon történt — nem kimerítő keresés. Emeld a --retmax-ot a teljességhez.")
    lines.append("-" * 64)
    lines.append("SZŰRÉS ÉS BEVÁLOGATÁS (rekord-szintű napló)")
    lines.append(f"  Duplikátum eltávolítva:            {f['dedup_removed']}")
    if f["removed_before_screening_n"]:
        lines.append(f"  Egyéb, szűrés előtt eltávolítva:   {f['removed_before_screening_n']}")
    lines.append(f"  Szűrt (egyedi behozott):           {f['screened']}")
    lines.append(f"  Kizárva a szűrésnél (cím/absztr.): {f['excluded_screening']}")
    lines.append(f"  Teljes szöveg keresve:             {f['sought_for_retrieval']}")
    lines.append(f"  Teljes szöveg nem elérhető:        {f['not_retrieved']}")
    lines.append(f"  Elbírálva (teljes szöveg):         {f['assessed_eligibility']}")
    lines.append(f"  Kizárva elbíráláskor:              {f['excluded_eligibility']}")
    for reason, n in sorted(f["excluded_eligibility_reasons"].items(), key=lambda x: -x[1]):
        lines.append(f"      - {reason}: {n}")
    lines.append(f"  BEVÁLOGATVA:                       {f['included']}")
    if f["undecided"]:
        lines.append(f"  (még döntésre vár:                 {f['undecided']})")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Export
# --------------------------------------------------------------------------


def export_flow_md(state: dict) -> str:
    f = compute_flow(state)
    dbs = ", ".join(f"{s.get('source','')} (n={s.get('count_total',0)}, {s.get('date','')})"
                    for s in f["databases"]) or "—"
    out = [
        f"# PRISMA 2020 folyamat — {state['project']}",
        "",
        f"A(z) {dbs} adatbázis(ok)ban végzett keresés **{f['identified_total']}** rekordot "
        f"azonosított.",
    ]
    if f["retrieval_gap"] > 0:
        out.append(
            f"Ebből **{f['retrieved_total']}** rekord került a korpuszba (retmax-korlát); a szűrés "
            f"erre a halmazra vonatkozik, így a keresés nem tekinthető kimerítőnek."
        )
    out += [
        "",
        f"- Rekordok azonosítva: **{f['identified_total']}**",
        f"- Duplikátum eltávolítva: **{f['dedup_removed']}**"
        + (f" (+ egyéb {f['removed_before_screening_n']})" if f["removed_before_screening_n"] else ""),
        f"- Rekord szűrve: **{f['screened']}**",
        f"- Kizárva a szűrésnél: **{f['excluded_screening']}**",
        f"- Teljes szöveg keresve / nem elérhető: **{f['sought_for_retrieval']}** / **{f['not_retrieved']}**",
        f"- Teljes szöveg elbírálva: **{f['assessed_eligibility']}**",
        f"- Kizárva elbíráláskor: **{f['excluded_eligibility']}**",
    ]
    for reason, n in sorted(f["excluded_eligibility_reasons"].items(), key=lambda x: -x[1]):
        out.append(f"    - {reason}: {n}")
    out.append(f"- **Beválogatva: {f['included']}**")
    if f["undecided"]:
        out.append(f"- (döntésre vár: {f['undecided']})")
    return "\n".join(out) + "\n"


def export_prisma_s(state: dict) -> str:
    """PRISMA-S keresési stratégia melléklet — pontosan ezt kérik a bírálók."""
    rows = state.get("searches", [])
    out = [
        f"# Keresési stratégia (PRISMA-S) — {state['project']}",
        "",
        "| # | Adatbázis | Felület | Keresés dátuma | Szűrők | Találat (Count) | Behozva |",
        "|---|-----------|---------|----------------|--------|-----------------|---------|",
    ]
    for i, s in enumerate(rows, 1):
        interface = "NCBI Entrez / E-utilities" if s.get("source") == "PubMed" else s.get("interface", "")
        out.append(
            f"| {i} | {s.get('source','')} | {interface} | {s.get('date','')} | "
            f"{s.get('filters','')} | {s.get('count_total',0)} | {s.get('retrieved',0)} |"
        )
    out += ["", "## Teljes keresőkifejezések", ""]
    for i, s in enumerate(rows, 1):
        out.append(f"**{i}. {s.get('source','')} — {s.get('topic','')}**")
        out.append("")
        out.append("```")
        out.append(s.get("query", ""))
        out.append("```")
        out.append("")
    return "\n".join(out) + "\n"


def export_flowchart_spec(state: dict) -> dict:
    """figure-forge flowchart JSON spec (nodes/edges) a PRISMA ábrához.

    Renderelés:
        python3 "$FF/scripts/ff.py" flowchart --spec prisma.flowchart.json \\
            --out prisma --formats svg,png,tiff --width single
    A kizáró dobozok pozíciója becsült; a figure-forge QC a feliratokat a dobozon
    belül tartja, a pontos y-t igény szerint hangold.
    """
    f = compute_flow(state)
    id_txt = f"Records identified (n={f['identified_total']}):\n" + "\n".join(
        f"{s.get('source','')} (n={s.get('count_total',0)})" for s in f["databases"]
    ) if f["databases"] else f"Records identified (n={f['identified_total']})"
    excl_reasons = "\n".join(f"{r} (n={n})" for r, n in f["excluded_eligibility_reasons"].items())
    # A figure-forge 0..100 vászna felül nagy y-nal: a bal oszlop a gerinc,
    # a jobb oszlop a kizáró dobozok, mindegyik a szülője alá kissé jobbra.
    # Minden csomópontnak adunk explicit koordinátát, hogy determinisztikusan
    # rendeződjön (a QC-hurok a feliratokat a dobozon belül tartja).
    SPINE_X, SIDE_X = 34, 80
    nodes = [
        {"id": "identified", "text": id_txt, "w": 44, "h": 14, "x": SPINE_X, "y": 92},
        {"id": "dup", "text": f"Duplicate records\nremoved (n={f['dedup_removed']})",
         "w": 38, "h": 12, "x": SIDE_X, "y": 84},
        {"id": "screened", "text": f"Records screened (n={f['screened']})",
         "w": 44, "h": 10, "x": SPINE_X, "y": 72},
        {"id": "excl_screen", "text": f"Records excluded\n(n={f['excluded_screening']})",
         "w": 38, "h": 12, "x": SIDE_X, "y": 64},
        {"id": "sought", "text": f"Reports sought for\nretrieval (n={f['sought_for_retrieval']})",
         "w": 44, "h": 10, "x": SPINE_X, "y": 52},
        {"id": "not_retrieved", "text": f"Reports not retrieved\n(n={f['not_retrieved']})",
         "w": 38, "h": 12, "x": SIDE_X, "y": 44},
        {"id": "assessed", "text": f"Reports assessed for\neligibility (n={f['assessed_eligibility']})",
         "w": 44, "h": 10, "x": SPINE_X, "y": 32},
        {"id": "excl_elig", "text": (f"Reports excluded (n={f['excluded_eligibility']}):\n" + excl_reasons)
         if excl_reasons else f"Reports excluded (n={f['excluded_eligibility']})",
         "w": 38, "h": 14, "x": SIDE_X, "y": 23},
        {"id": "included", "text": f"Studies included (n={f['included']})",
         "w": 44, "h": 10, "x": SPINE_X, "y": 11},
    ]
    edges = [
        {"from": "identified", "to": "dup"},
        {"from": "identified", "to": "screened"},
        {"from": "screened", "to": "excl_screen"},
        {"from": "screened", "to": "sought"},
        {"from": "sought", "to": "not_retrieved"},
        {"from": "sought", "to": "assessed"},
        {"from": "assessed", "to": "excl_elig"},
        {"from": "assessed", "to": "included"},
    ]
    return {"direction": "TB", "nodes": nodes, "edges": edges}


def included_records(state: dict) -> list[dict]:
    return sorted(
        (r for r in state["records"].values() if r["decision"] == "include"),
        key=lambda r: (r.get("folyoirat", ""), r.get("pmid", "")),
    )


def export_ris(state: dict) -> str:
    out: list[str] = []
    for r in included_records(state):
        out.append("TY  - JOUR")
        if r.get("cim"):
            out.append(f"TI  - {r['cim']}")
        if r.get("folyoirat"):
            out.append(f"JO  - {r['folyoirat']}")
        y = year_of(r.get("publikacio_datuma", ""))
        if y:
            out.append(f"PY  - {y}")
        if r.get("doi"):
            out.append(f"DO  - {r['doi']}")
        if r.get("pubmed_url"):
            out.append(f"UR  - {r['pubmed_url']}")
        if r.get("pmid"):
            out.append(f"AN  - {r['pmid']}")
        out.append("ER  - ")
        out.append("")
    return "\n".join(out)


def export_included_csv(state: dict, path: Path) -> int:
    recs = included_records(state)
    cols = ["pmid", "cim", "folyoirat", "publikacio_datuma", "doi", "pubmed_url"]
    with path.open("w", encoding="utf-8-sig", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=cols)
        w.writeheader()
        for r in recs:
            w.writerow({c: r.get(c, "") for c in cols})
    return len(recs)


def do_export(state: dict, outdir: Path, project: str, fmt: str, out_dir: Path | None) -> None:
    out_dir = out_dir or (outdir / "prisma" / "export" / project)
    out_dir.mkdir(parents=True, exist_ok=True)
    want = {"flow-md", "flow-json", "prisma-s", "flowchart", "ris", "csv"} if fmt == "all" else {fmt}
    written: list[Path] = []

    if "flow-md" in want:
        p = out_dir / "prisma-flow.md"; p.write_text(export_flow_md(state), encoding="utf-8"); written.append(p)
    if "flow-json" in want:
        p = out_dir / "prisma-flow.json"
        p.write_text(json.dumps(compute_flow(state), ensure_ascii=False, indent=2), encoding="utf-8")
        written.append(p)
    if "prisma-s" in want:
        p = out_dir / "search-strategy.md"; p.write_text(export_prisma_s(state), encoding="utf-8"); written.append(p)
    if "flowchart" in want:
        p = out_dir / "prisma.flowchart.json"
        p.write_text(json.dumps(export_flowchart_spec(state), ensure_ascii=False, indent=2), encoding="utf-8")
        written.append(p)
    if "ris" in want:
        p = out_dir / "included.ris"; p.write_text(export_ris(state), encoding="utf-8"); written.append(p)
    if "csv" in want:
        p = out_dir / "included.csv"; export_included_csv(state, p); written.append(p)

    print("Exportálva:")
    for p in written:
        print(f"  {p}")
    if "flowchart" in want:
        print("\nÁbra renderelése (figure-forge):")
        print('  FF=~/Documents/claude/szk-plugins/plugins/figure-forge')
        print(f'  python3 "$FF/scripts/ff.py" flowchart --spec "{out_dir/"prisma.flowchart.json"}" '
              f'--out "{out_dir/"prisma"}" --formats svg,png,tiff --width single')


# --------------------------------------------------------------------------
# Import (előtte): korábbi állapot vagy döntés-CSV
# --------------------------------------------------------------------------


def import_source(state: dict, path: Path) -> None:
    if not path.exists():
        sys.exit(f"Nincs ilyen fájl: {path}")
    if path.suffix.lower() == ".json":
        other = json.loads(path.read_text(encoding="utf-8"))
        if other.get("schema") != SCHEMA:
            print("  ! a JSON nem PRISMA állapot; kihagyva.", file=sys.stderr)
            return
        # keresések uniója
        existing = {(s.get("source"), s.get("query"), s.get("date")) for s in state["searches"]}
        add_s = 0
        for s in other.get("searches", []):
            key = (s.get("source"), s.get("query"), s.get("date"))
            if key not in existing:
                state["searches"].append(s); existing.add(key); add_s += 1
        # rekordok uniója: a döntött állapot nyer
        add_r = merged_r = 0
        for pmid, orec in other.get("records", {}).items():
            cur = state["records"].get(pmid)
            if cur is None:
                state["records"][pmid] = orec; add_r += 1
            elif not cur.get("decision") and orec.get("decision"):
                cur["decision"] = orec["decision"]; cur["reason"] = orec.get("reason", "")
                cur["phase"] = orec.get("phase", ""); merged_r += 1
        state["dedup_removed"] = max(int(state.get("dedup_removed", 0)),
                                     int(other.get("dedup_removed", 0)))
        print(f"Importálva JSON-ból: {add_s} keresés, {add_r} új rekord, {merged_r} döntés átvéve.")
    else:
        with path.open("r", encoding="utf-8-sig", newline="") as fh:
            rows = list(csv.DictReader(fh))
        applied, skipped = apply_decisions(state, rows)
        print(f"Importálva döntés-CSV-ből: {applied} döntés alkalmazva, {skipped} kihagyva.")


def write_template(state: dict, out_path: Path) -> int:
    """Kitöltendő szűrési döntés-CSV a még el nem bírált rekordokból."""
    cols = ["pmid", "cim", "folyoirat", "publikacio_datuma", "statusz_fulltext",
            "decision", "reason", "phase"]
    todo = [r for r in state["records"].values() if not r["decision"]]
    todo.sort(key=lambda r: (r.get("folyoirat", ""), r.get("pmid", "")))
    with out_path.open("w", encoding="utf-8-sig", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=cols)
        w.writeheader()
        for r in todo:
            w.writerow({
                "pmid": r["pmid"], "cim": r["cim"], "folyoirat": r["folyoirat"],
                "publikacio_datuma": r["publikacio_datuma"], "statusz_fulltext": r["fulltext"],
                "decision": "", "reason": "", "phase": "",
            })
    return len(todo)


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description="PRISMA napló és folyamatábra a Collector-höz (import előtte, export utána).",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    p.add_argument("--outdir", type=Path, default=DEFAULT_OUTDIR, help="Munkamappa (a collect kimenete).")
    p.add_argument("--project", default="review", help="Projekt-szelet (állapotfájl neve).")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("init", help="Új PRISMA állapot létrehozása.")
    sp.add_argument("--title", default="", help="Emberi cím a projekthez.")

    sp = sub.add_parser("ingest", help="Keresési napló + collect CSV beolvasása.")
    sp.add_argument("--csv", type=Path, help="collect CSV (alap: <outdir>/osszesitett_lista.csv).")
    sp.add_argument("--search-log", type=Path, help="Keresési napló (alap: <outdir>/kereses_naplo.jsonl).")
    sp.add_argument("--source", default="PubMed", help="Rekordok forrásának neve.")

    sp = sub.add_parser("add-source", help="Kézi adatbázis/regiszter az azonosításhoz.")
    sp.add_argument("--source", required=True, help='Pl. "Embase", "Cochrane CENTRAL".')
    sp.add_argument("--count", type=int, required=True, help="Azonosított rekordok száma (Count).")
    sp.add_argument("--date", default="", help="Keresés dátuma (ÉÉÉÉ-HH-NN).")
    sp.add_argument("--query", default="", help="Keresőkifejezés.")
    sp.add_argument("--kind", default="database", choices=["database", "register", "other"])
    sp.add_argument("--retrieved", type=int, default=0, help="Behozott rekordok (ha van).")

    sp = sub.add_parser("dedup", help="Duplikátumok eltávolítása / rögzítése.")
    sp.add_argument("--auto", action="store_true", help="DOI, majd cím szerinti automatikus dedup.")
    sp.add_argument("--removed", type=int, help="Külső dedup rekordszáma (kézi).")

    sp = sub.add_parser("screen", help="Szűrési/elbírálási döntések rögzítése.")
    sp.add_argument("--include", nargs="+", metavar="PMID", help="Beválogatandó PMID(-ek).")
    sp.add_argument("--exclude", metavar="PMID", help="Kizárandó PMID.")
    sp.add_argument("--reason", default="", help="Kizárás oka.")
    sp.add_argument("--phase", choices=["screen", "eligibility"], help="Kizárás fázisa.")
    sp.add_argument("--from-csv", type=Path, help="Döntés-CSV (pmid,decision,reason,phase).")

    sp = sub.add_parser("template", help="Kitöltendő szűrési döntés-CSV kiírása.")
    sp.add_argument("--out", type=Path, help="Kimeneti CSV útvonala.")

    sub.add_parser("status", help="A PRISMA folyamat aktuális számai.")

    sp = sub.add_parser("import", help="Korábbi állapot (.json) vagy döntés-CSV importja.")
    sp.add_argument("file", type=Path, help="Importálandó fájl.")

    sp = sub.add_parser("export", help="Kimenetek: folyamat, PRISMA-S, ábra, RIS/CSV.")
    sp.add_argument("--format", default="all",
                    choices=["flow-md", "flow-json", "prisma-s", "flowchart", "ris", "csv", "all"])
    sp.add_argument("--out", type=Path, help="Kimeneti mappa.")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    outdir: Path = args.outdir
    project: str = args.project

    if args.cmd == "init":
        state = fresh_state(project, args.title)
        path = save_state(state, outdir, project)
        print(f"Létrehozva: {path}")
        return 0

    # A többi parancs betölti (vagy ingestnél létrehozza) az állapotot.
    create = args.cmd == "ingest"
    state = load_state(outdir, project, create=create)

    if args.cmd == "ingest":
        ingest(state, outdir, args.csv, args.search_log, args.source)
    elif args.cmd == "add-source":
        state["searches"].append({
            "kind": args.kind, "source": args.source, "topic": "", "query": args.query,
            "date": args.date, "count_total": args.count, "retrieved": args.retrieved, "filters": "",
        })
        print(f"Forrás hozzáadva: {args.source} (n={args.count}, {args.kind}).")
    elif args.cmd == "dedup":
        dedup(state, args.auto, args.removed)
    elif args.cmd == "screen":
        if args.from_csv:
            with args.from_csv.open("r", encoding="utf-8-sig", newline="") as fh:
                rows = list(csv.DictReader(fh))
            applied, skipped = apply_decisions(state, rows)
            print(f"{applied} döntés alkalmazva, {skipped} kihagyva.")
        else:
            rows = []
            if args.include:
                rows += [{"pmid": p, "decision": "include"} for p in args.include]
            if args.exclude:
                rows.append({"pmid": args.exclude, "decision": "exclude",
                             "reason": args.reason, "phase": args.phase or "screen"})
            if not rows:
                print("Adj meg --include PMID..., --exclude PMID, vagy --from-csv fájlt.")
                return 2
            applied, _ = apply_decisions(state, rows)
            print(f"{applied} döntés rögzítve.")
    elif args.cmd == "template":
        out_path = args.out or (outdir / "prisma" / f"{project}-szures.csv")
        out_path.parent.mkdir(parents=True, exist_ok=True)
        n = write_template(state, out_path)
        print(f"{n} el nem bírált rekord kiírva: {out_path}")
        print("  Töltsd ki a decision (include/exclude), reason, phase (screen/eligibility) "
              "oszlopokat, majd:  prisma screen --from-csv " + str(out_path))
        return 0
    elif args.cmd == "status":
        print(status_text(state))
        return 0
    elif args.cmd == "import":
        import_source(state, args.file)
    elif args.cmd == "export":
        do_export(state, outdir, project, args.format, args.out)
        return 0

    save_state(state, outdir, project)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
