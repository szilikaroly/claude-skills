SCICOUNCIL_PANEL=claude,openai,gemini,ollama
CLAUDE_MODEL=opus
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
XAI_API_KEY=
XAI_MODEL=grok-4
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
SCICOUNCIL_MAX_ROUNDS=2
SCICOUNCIL_CONSENSUS_THRESHOLD=0.70
SCICOUNCIL_ALLOW_RCODE=true
SCICOUNCIL_TIMEOUT=240

# --- Claude Science (specialist envs + connectors) ---
# CLAUDE_SCIENCE_HOME=~/.claude-science
# SCICOUNCIL_RSCRIPT=            # pin an Rscript, overrides specialist routing

# Contact address sent to Crossref / Europe PMC in the User-Agent (they ask for one)
SCICOUNCIL_CONTACT=
